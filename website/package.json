{
  "name": "clubsplatform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "api:gen": "npm ci --silent --no-audit --no-fund --prefix tools/openapi && tools/openapi/node_modules/.bin/openapi-typescript ../openapi.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@mantine/core": "9.7.3",
    "@mantine/dates": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@posthog/react": "^1.11.3",
    "@tabler/icons-react": "^3.49.0",
    "better-auth": "^1.7.12",
    "dayjs": "^1.11.23",
    "posthog-js": "^1.438.21",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@posthog/rollup-plugin": "^1.6.1",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "postcss": "^8.5.31",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
