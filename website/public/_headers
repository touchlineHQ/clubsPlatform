# The sha256 in script-src is Vite's modulePreload polyfill (added in 0eacd39).
# It looks redundant now: there is no inline <script> in website/index.html or in
# the built dist/index.html, and in this Vite version the polyfill ships inside
# the entry chunk, which script-src 'self' already covers. Left in place rather
# than removed pending verification. Local preview with `wrangler pages dev`
# serves static assets and processes _headers, so it can be used to check the
# policy in a browser. Removing the hash is a deliberate follow-up.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-BqkcRCrmz7F9NbeBGIr6y2r17URD8BoJH02b5v5Q/E0=' https://p.touchlinehq.co.uk; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://fixtures.touchlinehq.co.uk/ https://p.touchlinehq.co.uk; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
